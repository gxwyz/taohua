# Database Configuration
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here
DB_CHARSET=utf8

# Database Table Prefix
DB_PREFIX=blast_

# Admin Configuration
ADMIN_SAFE_PASSWORD=your_secure_admin_password_here

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# Session Configuration
SESSION_LIFETIME=900

# Node Access (if applicable)
NODE_ACCESS_URL=http://localhost:65531

# Security Settings
# Generate a strong random key for session encryption
APP_KEY=generate_a_random_32_character_key

# File Upload Settings
UPLOAD_MAX_SIZE=2097152
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif

# Backup Directory (outside web root recommended)
BACKUP_DIR=../backups/

# Notes:
# 1. Use strong passwords (minimum 16 characters, mixed case, numbers, symbols)
# 2. Never use 'root' as DB_USER in production
# 3. Create a dedicated database user with minimal required permissions
# 4. Keep .env file permissions set to 600 (owner read/write only)
# 5. Regularly rotate passwords
# 6. Use password manager to generate and store credentials
